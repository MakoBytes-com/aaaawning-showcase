# ─── Email (Resend) ───────────────────────────────────────────────
# Resend API key. Create at https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives contact/estimate form submissions
CONTACT_EMAIL_TO=admin@aaaawning.net
# Sender the form uses (must be a verified Resend domain)
CONTACT_EMAIL_FROM=website@aaaawning.net

# ─── Cloudflare Turnstile (captcha) ───────────────────────────────
# Site key (public) + secret (server). Create at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Google Places (for live GBP reviews) ─────────────────────────
# API key with Places API enabled
GOOGLE_PLACES_API_KEY=
# Place ID for AAA Awning Co., Inc.
GOOGLE_PLACE_ID=

# ─── Site ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://aaaawning.net
